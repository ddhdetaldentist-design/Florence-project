# Your Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role Key (Only used server-side for admin operations, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
